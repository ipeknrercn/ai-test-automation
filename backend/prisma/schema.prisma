// backend/prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
  previewFeatures = []
}

model Test {
  id          Int       @id @default(autoincrement())
  testName    String
  description String?
  userPrompt  String    @db.Text
  targetUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  testRuns       TestRun[]
  promptVersions PromptVersion[]

  @@map("tests")
}

model TestRun {
  id          Int       @id @default(autoincrement())
  testId      Int
  status      String
  startTime   DateTime
  endTime     DateTime?
  durationMs  Int?
  errorMsg    String?   @db.Text
  browser     String    @default("chromium")

  promptVersionId Int?

  test            Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id])
  steps           TestStep[]

  // YENİ: Many-to-many ilişki — bir test birden fazla klasörde olabilir
  folderLinks     TestRunFolder[]

  createdAt   DateTime  @default(now())

  @@index([testId])
  @@index([status])
  @@index([promptVersionId])
  @@map("test_runs")
}

model TestStep {
  id            Int       @id @default(autoincrement())
  testRunId     Int
  stepNumber    Int
  timestamp     DateTime
  action        String
  target        String?   @db.Text
  value         String?   @db.Text
  screenshotId  Int?
  aiReasoning   String?   @db.Text
  aiConfidence  Float?
  success       Boolean   @default(true)
  errorMsg      String?   @db.Text
  durationMs    Int?

  testRun       TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  screenshot    Screenshot? @relation(fields: [screenshotId], references: [id])

  createdAt     DateTime  @default(now())

  @@index([testRunId])
  @@map("test_steps")
}

model PromptVersion {
  id                Int       @id @default(autoincrement())
  testId            Int
  version           String
  promptText        String    @db.Text
  totalRuns         Int       @default(0)
  successCount      Int       @default(0)
  failCount         Int       @default(0)
  bugCount          Int       @default(0)
  successRate       Float     @default(0)
  avgDurationMs     Int?
  parentVersionId   Int?
  improvementReason String?   @db.Text
  isActive          Boolean   @default(true)

  test              Test            @relation(fields: [testId], references: [id], onDelete: Cascade)
  parentVersion     PromptVersion?  @relation("VersionHistory", fields: [parentVersionId], references: [id])
  childVersions     PromptVersion[] @relation("VersionHistory")
  testRuns          TestRun[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([testId, version])
  @@index([testId])
  @@map("prompt_versions")
}

model Screenshot {
  id          Int       @id @default(autoincrement())
  filePath    String
  fileSize    Int?
  width       Int?
  height      Int?
  format      String    @default("png")

  testSteps   TestStep[]

  createdAt   DateTime  @default(now())

  @@map("screenshots")
}

model Folder {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  color       String    @default("#3b82f6")
  icon        String?

  // YENİ: Many-to-many ilişki
  testRunLinks TestRunFolder[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("folders")
}

// YENİ MODEL — Many-to-many ara tablosu (junction table)
// Bir test birden fazla klasörde olabilir, bir klasörde birden fazla test olabilir
model TestRunFolder {
  testRunId   Int
  folderId    Int
  addedAt     DateTime  @default(now())

  testRun     TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  folder      Folder    @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@id([testRunId, folderId])
  @@index([testRunId])
  @@index([folderId])
  @@map("test_run_folders")
}
